# Markdown versions of pages and llms-full.txt repeat the HTML pages' content.
# They are for agents, not search results.
/*.md
  X-Robots-Tag: noindex

/llms-full.txt
  X-Robots-Tag: noindex

# Registry items are fetched by the shadcn CLI and by agents from any origin.
/r/*
  Access-Control-Allow-Origin: *
  X-Robots-Tag: noindex
