---
import { type CollectionEntry, getCollection } from 'astro:content'

import BaseLayout from '../layouts/BaseLayout.astro'
import LastUpdated from '../components/LastUpdated.astro'
import { SITE_URL } from '../utils/patterns'

const patterns: CollectionEntry<'patterns'>[] = await getCollection('patterns')

const agentRoutes = [
  {
    copyName: 'agentRouteLlms',
    copyLabel: 'llms.txt URL',
    title: 'Point your assistant at the docs',
    description:
      'llms.txt indexes a Markdown version of every pattern, with its options, behavior contract and full registration source.',
    command: `${SITE_URL}/llms.txt`,
  },
  {
    copyName: 'agentRouteRegistry',
    copyLabel: 'install command',
    title: 'Add a pattern to a project',
    description:
      'Each pattern is a shadcn-compatible registry item. The command writes the registration and a markup example into ./hyperux; no components.json needed.',
    command: `npx shadcn@latest add ${SITE_URL}/r/dialog.json`,
  },
  {
    copyName: 'agentRouteSkill',
    copyLabel: 'skill command',
    title: 'Teach your agent the conventions',
    description:
      'The HyperUX skill tells coding agents when to reach for a pattern, how to load it before Alpine starts and which ARIA wiring to keep.',
    command: 'npx skills add markmead/hyperux',
  },
]

const lastUpdated =
  patterns.length > 0
    ? patterns.reduce((latest, pattern) => {
        return pattern.data.modDate > latest ? pattern.data.modDate : latest
      }, new Date(0))
    : null
---

<BaseLayout
  title="Free Alpine.js UI Patterns for Developers"
  description="Behavior-first Alpine.js patterns you can copy, adapt, and ship."
>
  <main id="main-content" class="mx-auto max-w-7xl space-y-8 px-4 py-8 sm:px-6 lg:px-8">
    <article class="prose prose-headings:font-semibold prose-lg">
      <h1>Free Alpine.js UI Patterns for Developers</h1>

      <p class="lead">Behavior-first Alpine.js patterns you can copy, adapt, and ship.</p>

      <p>
        HyperUX is not about repackaging HTML elements and functionality as components. It focuses
        on developer-friendly APIs for behavior-heavy UI patterns you can adapt to your own markup
        and styles.
      </p>

      {lastUpdated && <LastUpdated date={lastUpdated} />}

      <nav>
        <ul>
          {
            patterns.map((pattern) => (
              <li>
                <a
                  href={`/patterns/${pattern.data.slug}`}
                  class="inline-block text-sky-700 underline underline-offset-2 hover:text-sky-900"
                >
                  Read the {pattern.data.title} documentation
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <section aria-labelledby="agents-heading">
        <h2 id="agents-heading">Use HyperUX with an AI assistant</h2>

        <p>
          Assistants write convincing UI code that often gets focus, keyboard and ARIA wrong. Hand
          them a tested pattern instead.
        </p>

        <ul class="not-prose space-y-4">
          {
            agentRoutes.map((agentRoute) => (
              <li class="overflow-hidden rounded-lg border border-gray-300 bg-white">
                <div class="space-y-1 px-4 py-3">
                  <h3 class="text-base font-semibold text-gray-900">{agentRoute.title}</h3>
                  <p class="text-sm text-gray-700">{agentRoute.description}</p>
                </div>

                <div class="flex items-center gap-2 bg-gray-900 px-4 py-2.5">
                  <code
                    data-hux-copy={agentRoute.copyName}
                    class="min-w-0 flex-1 font-mono text-sm break-all text-gray-100"
                  >
                    {agentRoute.command}
                  </code>

                  <button
                    type="button"
                    x-data={`huxCopy({ valueSourceNames: ['${agentRoute.copyName}'] })`}
                    class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-100 hover:bg-gray-700"
                    x-on:click="copyToClipboard()"
                  >
                    <span aria-live="polite" x-text="hasCopied ? 'Copied' : 'Copy'">
                      Copy
                    </span>
                    <span class="sr-only">{agentRoute.copyLabel}</span>
                  </button>
                </div>
              </li>
            ))
          }
        </ul>
      </section>
    </article>
  </main>
</BaseLayout>
