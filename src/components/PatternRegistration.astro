---
// Every file in ./patterns is one Alpine.data() registration. Each is inlined
// with a `data-hux-copy="<name>Registration"` marker so demo copy buttons can
// include the registration source.
const registrationSources = import.meta.glob<string>('./patterns/*.js', {
  query: '?raw',
  import: 'default',
  eager: true,
})

const registrations = Object.entries(registrationSources).map(([filePath, source]) => ({
  name: filePath.replace(/^\.\/patterns\//, '').replace(/\.js$/, ''),
  source,
}))
---

{
  registrations.map(({ name, source }) => (
    <script is:inline data-hux-copy={`${name}Registration`} set:html={source} />
  ))
}
