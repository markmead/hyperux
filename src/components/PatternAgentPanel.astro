---
import { renderPatternMarkdown } from '../utils/markdown'
import { findPattern, getPatterns, installCommand } from '../utils/patterns'

interface Props {
  slug: string
}

const { slug } = Astro.props

const patterns = await getPatterns()
const pattern = findPattern(patterns, slug)
const patternMarkdown = renderPatternMarkdown(pattern, patterns)
const command = installCommand(slug)
---

<section
  aria-labelledby="use-with-ai-heading"
  class="mx-auto max-w-[calc(65ch+6rem)] rounded-lg border border-gray-300 bg-white"
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-3">
    <h2 id="use-with-ai-heading" class="text-sm font-semibold text-gray-900">Use with AI</h2>

    <div class="flex flex-wrap items-center gap-2 text-sm">
      <textarea hidden readonly data-hux-copy="patternMarkdown" aria-hidden="true" tabindex="-1"
        >{patternMarkdown}</textarea
      >

      <button
        type="button"
        x-data="huxCopy({ valueSourceNames: ['patternMarkdown'] })"
        class="rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium hover:bg-gray-100"
        x-on:click="copyToClipboard()"
      >
        <span aria-live="polite" x-text="hasCopied ? 'Copied docs + source' : 'Copy for AI'">
          Copy for AI
        </span>
      </button>

      <a
        href={`/patterns/${slug}.md`}
        class="rounded-md px-3 py-1.5 font-medium text-sky-700 underline underline-offset-2 hover:text-sky-900"
      >
        Markdown
      </a>

      <a
        href={`/r/${slug}.json`}
        class="rounded-md px-3 py-1.5 font-medium text-sky-700 underline underline-offset-2 hover:text-sky-900"
      >
        Registry JSON
      </a>
    </div>
  </div>

  <div class="flex items-center gap-2 border-t border-gray-200 bg-gray-900 px-4 py-2.5">
    <span class="shrink-0 font-mono text-sm text-gray-400 select-none" aria-hidden="true">$</span>

    <code
      data-hux-copy={`installCommand-${slug}`}
      class="min-w-0 flex-1 font-mono text-sm break-all text-gray-100">{command}</code
    >

    <button
      type="button"
      x-data={`huxCopy({ valueSourceNames: ['installCommand-${slug}'] })`}
      class="shrink-0 rounded-md px-2 py-1 text-sm font-medium text-gray-100 hover:bg-gray-700"
      x-on:click="copyToClipboard()"
    >
      <span aria-live="polite" x-text="hasCopied ? 'Copied' : 'Copy command'">Copy command</span>
    </button>
  </div>
</section>
