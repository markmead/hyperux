---
import CommandStrip from './CommandStrip.astro'
import { markdownPathFor } from '../utils/markdownPath'
import { installCommand } from '../utils/patterns'

interface Props {
  slug: string
}

const { slug } = Astro.props

const markdownPath = markdownPathFor(`/patterns/${slug}`)
---

<section
  aria-labelledby="use-with-ai-heading"
  class="mx-auto max-w-[calc(65ch+6rem)] overflow-hidden rounded-lg border border-gray-300 bg-white"
>
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3 px-4 py-3">
    <h2 id="use-with-ai-heading" class="text-sm font-semibold text-gray-900">Use with AI</h2>

    <div class="flex flex-wrap items-center gap-2 text-sm">
      <!--
        Copies the page's prerendered Markdown (docs + registration source) on
        click instead of embedding it in every page. The fetch promise goes into
        ClipboardItem so Safari keeps the click's user activation.
      -->
      <button
        type="button"
        x-data={`{
          hasCopied: false,
          async copyPatternMarkdown() {
            const markdownBlob = fetch('${markdownPath}')
              .then((markdownResponse) => markdownResponse.text())
              .then((markdownText) => new Blob([markdownText], { type: 'text/plain' }))

            try {
              await navigator.clipboard.write([new ClipboardItem({ 'text/plain': markdownBlob })])
              this.hasCopied = true
              setTimeout(() => (this.hasCopied = false), 2000)
            } catch (copyError) {
              console.error('[Use with AI] Could not copy the Markdown', copyError)
            }
          },
        }`}
        class="rounded-md border border-gray-300 bg-white px-3 py-1.5 font-medium hover:bg-gray-100"
        x-on:click="copyPatternMarkdown()"
      >
        <span aria-live="polite" x-text="hasCopied ? 'Copied docs + source' : 'Copy for AI'">
          Copy for AI
        </span>
      </button>

      <a
        href={markdownPath}
        class="rounded-md px-3 py-1.5 font-medium text-sky-700 underline underline-offset-2 hover:text-sky-900"
      >
        Markdown
      </a>

      <a
        href={`/r/${slug}.json`}
        class="rounded-md px-3 py-1.5 font-medium text-sky-700 underline underline-offset-2 hover:text-sky-900"
      >
        Registry JSON
      </a>
    </div>
  </div>

  <CommandStrip
    command={installCommand(slug)}
    copyName={`installCommand-${slug}`}
    copyLabel="install command"
    showPrompt
  />
</section>
